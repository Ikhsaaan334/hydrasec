# ── HydraSec environment ────────────────────────────────────────────────
# Salin file ini menjadi .env lalu sesuaikan:  cp .env.example .env

# Port gateway nginx yang di-expose ke host (buka http://localhost:8080)
GATEWAY_PORT=8080

# Port web UI MailPit (inbox OTP, buka http://localhost:8025)
MAILPIT_PORT=8025

# PostgreSQL
POSTGRES_USER=hydrasec
POSTGRES_PASSWORD=hydrasec
POSTGRES_DB=hydrasec

# JWT — WAJIB diganti untuk deployment sungguhan
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_TTL=7d

# SMTP pengirim OTP. Default: MailPit lokal (inbox di http://localhost:8025).
# Untuk SMTP sungguhan, contoh: smtp://user:pass@smtp.gmail.com:587
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=HydraSec <no-reply@hydrasec.local>

# OTP
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN=60

# Konkurensi worker (jumlah kontainer tool yang jalan bersamaan)
WORKER_CONCURRENCY=2

# false = target localhost/IP privat/lingkapan DITOLAK (hardening SSRF default).
# Set true hanya untuk lab lokal (mis. memindai DVWA di 192.168.x.x).
ALLOW_PRIVATE_TARGETS=false
